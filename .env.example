# Budget Tracker Environment Configuration
# Copy this file to .env.local and fill in your actual credentials

# ============================================================
# AI PROVIDER CONFIGURATION
# ============================================================

# Primary AI provider to use for transaction analysis
# Supported: gemini, claude, openai
AI_PRIMARY_PROVIDER=gemini

# Fallback providers (comma-separated, will be tried in order if primary fails)
# Example: gemini,claude,openai
AI_FALLBACK_PROVIDERS=claude,openai

# ============================================================
# GOOGLE GEMINI CONFIGURATION
# ============================================================

# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (optional, defaults to gemini-flash-lite-latest)
# Options: gemini-flash-lite-latest, gemini-flash, gemini-pro
GEMINI_MODEL=gemini-flash-lite-latest

# ============================================================
# ANTHROPIC CLAUDE CONFIGURATION
# ============================================================

# Get API key from: https://console.anthropic.com/account/keys
CLAUDE_API_KEY=your_claude_api_key_here

# Model to use (optional, defaults to claude-3-5-haiku)
# Options: claude-3-5-haiku, claude-3-5-sonnet, claude-3-opus
CLAUDE_MODEL=claude-3-5-haiku

# ============================================================
# OPENAI CONFIGURATION
# ============================================================

# Get API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (optional, defaults to gpt-3.5-turbo)
# Options: gpt-3.5-turbo, gpt-4-turbo, gpt-4o
OPENAI_MODEL=gpt-3.5-turbo

# ============================================================
# GOOGLE SHEETS CONFIGURATION
# ============================================================

# Google Sheets ID to store transactions
GOOGLE_SHEET_ID=your_sheet_id_here

# Service account key (JSON format)
# Get from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ============================================================
# CASHEW APP INTEGRATION
# ============================================================

# Cashew Allowed Accounts (JSON array - no mapping)
# List of allowed account names in your Cashew app
# If account not parsed/found, uses first account as default
# Leave empty to accept any account name

# Ukrainian Banks Example:
CASHEW_ACCOUNTS=["Mono","Privat","Ukrsib"]

# US Banks Example:
# CASHEW_ACCOUNTS=["Wells Fargo","Chase","AmEx","Fidelity","HSA"]

# European Banks Example:
# CASHEW_ACCOUNTS=["ING","Revolut","Wise","Bunq","N26"]

# Multi-Currency Example:
# CASHEW_ACCOUNTS=["UAH Account","EUR Account","USD Account","BTC Wallet","Card"]

# Cashew Category Allowed List (JSON array)
# If category from AI not in list, uses first category as default
# Leave empty to accept categories in any language (AI will detect)

# Ukrainian categories example:
CASHEW_CATEGORIES=["Побут","Покупки","Розваги","Рахунки та засоби","Подарунки","Освіта","Здоров'я","Підписки","Доходи","Краса","Подорожі","Донати","Авто","Транспорт","Будинок"]

# English categories example:
# CASHEW_CATEGORIES=["Food & Groceries","Shopping","Entertainment","Bills & Utilities","Gifts","Education","Health & Medical","Subscriptions","Income","Beauty","Travel","Donations","Automotive","Transportation","Home & Housing"]

# Minimal example (3 categories):
# CASHEW_CATEGORIES=["Food","Shopping","Other"]

# Mixed language example (any language):
# CASHEW_CATEGORIES=["Food","Shopping","Розваги","Bills","Подорожі"]

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable debug logging for webhook requests
DEBUG_MODE=false
