# Budget Tracker Environment Configuration
# Copy this file to .env.local and fill in your actual credentials

# ============================================================
# AI PROVIDER CONFIGURATION
# ============================================================

# Primary AI provider to use for transaction analysis
# Supported: gemini, claude, openai
AI_PRIMARY_PROVIDER=gemini

# Fallback providers (comma-separated, will be tried in order if primary fails)
# Example: gemini,claude,openai
AI_FALLBACK_PROVIDERS=claude,openai

# ============================================================
# GOOGLE GEMINI CONFIGURATION
# ============================================================

# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (optional, defaults to gemini-flash-lite-latest)
# Options: gemini-flash-lite-latest, gemini-flash, gemini-pro
GEMINI_MODEL=gemini-flash-lite-latest

# ============================================================
# ANTHROPIC CLAUDE CONFIGURATION
# ============================================================

# Get API key from: https://console.anthropic.com/account/keys
CLAUDE_API_KEY=your_claude_api_key_here

# Model to use (optional, defaults to claude-3-5-haiku)
# Options: claude-3-5-haiku, claude-3-5-sonnet, claude-3-opus
CLAUDE_MODEL=claude-3-5-haiku

# ============================================================
# OPENAI CONFIGURATION
# ============================================================

# Get API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (optional, defaults to gpt-3.5-turbo)
# Options: gpt-3.5-turbo, gpt-4-turbo, gpt-4o
OPENAI_MODEL=gpt-3.5-turbo

# ============================================================
# GOOGLE SHEETS CONFIGURATION
# ============================================================

# Google Sheets ID to store transactions
GOOGLE_SHEET_ID=your_sheet_id_here

# Service account key (JSON format)
# Get from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ============================================================
# CASHEW APP INTEGRATION
# ============================================================

# Shared secret for the /cashew-link webhook.
# Clients must send it in the `x-api-key` request header.
# If unset, /cashew-link rejects every request (fails closed).
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_secret_here

# Cashew Allowed Accounts (JSON array - no mapping)
# Account names as they exist in your Cashew app (matched case-insensitively)
# ORDER MATTERS: the FIRST item is the fallback when the account is missing or unknown
# Restart the server after editing (config is read once at startup)
# Leave empty to accept any account name

# Ukrainian Banks Example (Ukrsib is the fallback):
CASHEW_ACCOUNTS=["Ukrsib","Mono","Privat"]

# US Banks Example:
# CASHEW_ACCOUNTS=["Wells Fargo","Chase","AmEx","Fidelity","HSA"]

# European Banks Example:
# CASHEW_ACCOUNTS=["ING","Revolut","Wise","Bunq","N26"]

# Multi-Currency Example:
# CASHEW_ACCOUNTS=["UAH Account","EUR Account","USD Account","BTC Wallet","Card"]

# Cashew Category Allowed List (JSON array of top-level category names)
# ORDER MATTERS: if the category from AI is not in the list, the FIRST item is used,
# so put a neutral catch-all (e.g. "Інше") first.
# Include an income category (e.g. "Доходи"): Cashew decides income vs expense from the category,
# so money received only lands as income if the AI can pick an income category.
# Names must match the ones in Cashew exactly (case-insensitive; ' and ’ are different characters).
# Values containing an apostrophe: wrap the whole value in `backticks` (as below) instead of single quotes.
# Leave unset to skip the check: the AI then picks from a built-in default list and the result is NOT matched to Cashew.
# Keep the list short (10-20) and mutually exclusive: that is what makes the AI's choice obvious.
CASHEW_CATEGORIES=`["Інше","Продукти","Кафе та ресторани","Транспорт","Авто","Дім","Рахунки та збори","Здоров'я","Покупки","Догляд за собою","Розваги","Підписки","Освіта","Подорожі","Подарунки","Благодійність","Доходи"]`

# Cashew Subcategories (optional, JSON object: category -> its subcategories)
# - Keys must be in CASHEW_CATEGORIES (others are ignored with a warning).
# - The AI picks a subcategory only from the category it chose; a subcategory that does not belong
#   to the final category is dropped and the transaction stays in the main category.
# - Subcategory names should be unique across categories: Cashew resolves the `subcategory`
#   link parameter by name and takes the first match.
# - Create the same categories/subcategories in Cashew first (exact names).
# - Avoid subcategory names that are bare words commonly seen in notifications of the OPPOSITE
#   direction: a subcategory called just "Перекази" under Доходи pulled "Переказ на картку" (money out)
#   into income in testing. "Перекази від людей" fixed it.
CASHEW_SUBCATEGORIES=`{"Транспорт":["Таксі","Громадський транспорт","Потяги та автобуси"],"Авто":["Паливо","Тех обслуговування","Паркування"],"Дім":["Оренда","Ремонт та меблі"],"Рахунки та збори":["Комуналка","Зв'язок та інтернет","Комісії банку"],"Здоров'я":["Аптека","Лікарі"],"Покупки":["Одяг","Електроніка","Інші товари"],"Розваги":["Події","Ігри","Дозвілля"],"Підписки":["Сервіси","Додатки"],"Освіта":["Школа","Уроки англійської","Курси","Інше"],"Подорожі":["Квитки","Житло","Розваги","Транспорт"],"Доходи":["Зарплата","Перекази від людей","Повернення та кешбек"]}`

# English example:
# CASHEW_CATEGORIES=["Other","Groceries","Dining","Transit","Car","Home","Bills & Fees","Health","Shopping","Beauty","Entertainment","Subscriptions","Education","Travel","Gifts","Charity","Income"]
# CASHEW_SUBCATEGORIES={"Car":["Fuel","Service","Parking"],"Transit":["Taxi","Public transport"]}

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable debug logging for webhook requests
DEBUG_MODE=false
